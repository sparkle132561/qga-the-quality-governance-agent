DATABASE_URL=postgresql+psycopg://quality:quality_demo@127.0.0.1:55432/quality
# Compose宿主端口；启动脚本可显式传-PostgresPort，真实入口传--postgres-port。
QUALITY_POSTGRES_PORT=55432
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_MODE=fake
# MODEL_MODE 非 fake 时必须显式配置会话签名密钥（本地随机串即可，勿提交真实值）；
# JWT_SECRET=change-me-local-random
